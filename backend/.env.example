# 复制为 .env 后按本机环境修改
# 配置前缀统一为 PHXXBLOG_, 避免与系统环境变量冲突
# 完整说明见 docs/architecture.md 的"部署与配置"一节

# ---- 必填 ----
# 数据库连接(MySQL 8/9, 字符集必须是 utf8mb4, 否则中文与 emoji 会截断)
PHXXBLOG_DATABASE_URL=mysql+pymysql://root:你的数据库密码@localhost:3306/phxxblog?charset=utf8mb4
# JWT 签名密钥, 至少 32 个字符。留空或用仓库里的默认占位值会拒绝启动(防止伪造 admin 令牌)。
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
PHXXBLOG_SECRET_KEY=请替换为至少32位的随机字符串

# ---- 常用 ----
# 本地开发建议 true; 生产必须 false(否则会把 SQL 与异常堆栈打到日志/响应)
PHXXBLOG_DEBUG=true
PHXXBLOG_SITE_URL=http://localhost:5173
PHXXBLOG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PHXXBLOG_UPLOAD_DIR=../assets/uploads
# 初始化脚本创建 admin 账号时使用; 不设置则随机生成并打印一次(重启不会重置已存在的账号)
# PHXXBLOG_ADMIN_PASSWORD=

# ---- 安全 ----
# 是否开放注册。个人博客请保持 false, 否则任意访客都能注册成 author 并上传文件。
PHXXBLOG_ALLOW_REGISTER=false
# 可信反向代理 IP(逗号分隔)。只有来自这些地址的请求才会采信 X-Forwarded-For。
# 直接用 uvicorn 暴露时留空; 放在 Nginx 后面时填 Nginx 的地址(如 127.0.0.1)。
PHXXBLOG_TRUSTED_PROXIES=
# 令牌有效期
PHXXBLOG_ACCESS_TOKEN_EXPIRE_MINUTES=30
PHXXBLOG_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 数据保留(由 scripts/cleanup_old_data.py 执行清理, 建议每月一次)----
# 访问明细 visit_logs 的保留天数。趋势图读的是按日聚合的 daily_stats(永久保留),
# 因此清理明细不影响趋势曲线; 但"访问来源/浏览器/设备"分布会变成近 N 天。
PHXXBLOG_DATA_RETENTION_DAYS=180
# 操作日志 operation_logs(审计用途)的保留天数
PHXXBLOG_AUDIT_LOG_RETENTION_DAYS=365

# ---- 其他 ----
# 离线 IP 归属地数据库(ip2region xdb), 缺失时归属地显示为"未知"
# PHXXBLOG_GEO_DB_PATH=backend/data/ip2region_v4.xdb
# 单文件上传上限(字节), 默认 100MB
# PHXXBLOG_MAX_UPLOAD_SIZE=104857600
