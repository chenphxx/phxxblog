# 依赖
node_modules/
frontend/node_modules/
frontend/dist/
backend/.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# 环境与本地配置(忽略 .env 及其变体, 保留可提交的示例文件)
.env*
!.env.example

# 日志与临时文件
*.log

# 上传文件(保留目录, 忽略内容)
assets/uploads/*
!assets/uploads/.gitkeep

# WordPress 导出数据(含文章内容与个人信息, 不入库)
assets/wordpress/

# 离线 IP 库(可用脚本下载)
backend/data/*.xdb

# 编辑器
.vscode/
.idea/

# 本地验证产物(截图等, 非源码)
output/
