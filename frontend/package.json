{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "//engines": "下限由 jsdom 30 -> undici 8 决定(undici 8 需要 node:worker_threads.markAsUncloneable)。CI 与 .nvmrc 用 Node 24; 详细原因见 README.md 的「Node 版本要求」。",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "node scripts/copy-vditor-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-vditor-assets.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:icons": "node scripts/check-icons.mjs",
    "check:size": "node scripts/measure-first-paint.mjs",
    "themes:generate": "node src/styles/themes/_source/generate-themes.mjs",
    "themes:audit": "node src/styles/themes/_source/audit.mjs",
    "themes:preview": "node src/styles/themes/_source/build-previews.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.19.0",
    "element-plus": "^2.14.4",
    "pinia": "^4.0.2",
    "vditor": "^3.11.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.8"
  }
}
